{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-tabs-12",
  "description": "التبويبات مع رمز فقط وشارة العد",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@arabicui/badge",
    "@arabicui/tabs"
  ],
  "files": [
    {
      "path": "registry/default/particles/p-tabs-12.tsx",
      "content": "import { HouseIcon, InboxIcon, SettingsIcon } from \"lucide-react\";\nimport { Badge } from \"@/registry/default/ui/badge\";\nimport { Tabs, TabsList, TabsPanel, TabsTab } from \"@/registry/default/ui/tabs\";\n\nexport default function Particle() {\n  return (\n    <Tabs className=\"items-center\" defaultValue=\"tab-1\">\n      <TabsList>\n        <TabsTab aria-label=\"نظرة عامة\" className=\"size-10!\" value=\"tab-1\">\n          <HouseIcon aria-hidden=\"true\" />\n        </TabsTab>\n        <TabsTab\n          aria-label=\"البريد الإلكتروني\"\n          className=\"size-10!\"\n          value=\"tab-2\"\n        >\n          <InboxIcon aria-hidden=\"true\" />\n          <Badge\n            className=\"absolute end-0 top-0 rounded-full not-in-data-active:opacity-64\"\n            size=\"sm\"\n          >\n            5\n          </Badge>\n        </TabsTab>\n        <TabsTab aria-label=\"الإعدادات\" className=\"size-10!\" value=\"tab-3\">\n          <SettingsIcon aria-hidden=\"true\" />\n        </TabsTab>\n      </TabsList>\n      <TabsPanel value=\"tab-1\">\n        <p className=\"p-4 text-center text-muted-foreground text-xs\">\n          نظرة عامة على المحتوى\n        </p>\n      </TabsPanel>\n      <TabsPanel value=\"tab-2\">\n        <p className=\"p-4 text-center text-muted-foreground text-xs\">\n          محتوى علبة الوارد\n        </p>\n      </TabsPanel>\n      <TabsPanel value=\"tab-3\">\n        <p className=\"p-4 text-center text-muted-foreground text-xs\">\n          إعدادات المحتوى\n        </p>\n      </TabsPanel>\n    </Tabs>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "categories": [
    "tabs",
    "badge"
  ],
  "type": "registry:block"
}