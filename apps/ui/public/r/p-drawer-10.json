{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-drawer-10",
  "description": "تحرير نموذج الملف الشخصي مع المتغيرات الافتراضية وتذييل بسيط",
  "registryDependencies": [
    "@arabicui/button",
    "@arabicui/drawer",
    "@arabicui/field",
    "@arabicui/form",
    "@arabicui/input"
  ],
  "files": [
    {
      "path": "registry/default/particles/p-drawer-10.tsx",
      "content": "import { Button } from \"@/registry/default/ui/button\";\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerPanel,\n  DrawerPopup,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@/registry/default/ui/drawer\";\nimport { Field, FieldLabel } from \"@/registry/default/ui/field\";\nimport { Form } from \"@/registry/default/ui/form\";\nimport { Input } from \"@/registry/default/ui/input\";\n\nexport default function Particle() {\n  return (\n    <div className=\"flex flex-wrap gap-2\">\n      <Drawer position=\"right\">\n        <DrawerTrigger render={<Button variant=\"outline\" />}>\n          تذييل افتراضي\n        </DrawerTrigger>\n        <DrawerPopup variant=\"inset\">\n          <DrawerHeader>\n            <DrawerTitle>تعديل الملف الشخصي</DrawerTitle>\n            <DrawerDescription>\n              قم بإجراء تغييرات على ملفك الشخصي هنا. انقر فوق حفظ عند الانتهاء\n              من ذلك.\n            </DrawerDescription>\n          </DrawerHeader>\n          <Form className=\"contents\">\n            <DrawerPanel className=\"grid gap-4\">\n              <Field>\n                <FieldLabel>الاسم</FieldLabel>\n                <Input defaultValue=\"مارجريت ويلز\" type=\"text\" />\n              </Field>\n              <Field>\n                <FieldLabel>اسم المستخدم</FieldLabel>\n                <Input defaultValue=\"@maggie.welsh\" type=\"text\" />\n              </Field>\n            </DrawerPanel>\n            <DrawerFooter>\n              <DrawerClose render={<Button variant=\"ghost\" />}>\n                إلغاء\n              </DrawerClose>\n              <Button>حفظ</Button>\n            </DrawerFooter>\n          </Form>\n        </DrawerPopup>\n      </Drawer>\n      <Drawer position=\"right\">\n        <DrawerTrigger render={<Button variant=\"outline\" />}>\n          تذييل بسيط\n        </DrawerTrigger>\n        <DrawerPopup variant=\"inset\">\n          <DrawerHeader>\n            <DrawerTitle>تعديل الملف الشخصي</DrawerTitle>\n            <DrawerDescription>\n              قم بإجراء تغييرات على ملفك الشخصي هنا. انقر فوق حفظ عند الانتهاء\n              من ذلك.\n            </DrawerDescription>\n          </DrawerHeader>\n          <Form className=\"contents\">\n            <DrawerPanel className=\"grid gap-4\">\n              <Field>\n                <FieldLabel>الاسم</FieldLabel>\n                <Input defaultValue=\"مارجريت ويلز\" type=\"text\" />\n              </Field>\n              <Field>\n                <FieldLabel>اسم المستخدم</FieldLabel>\n                <Input defaultValue=\"@maggie.welsh\" type=\"text\" />\n              </Field>\n            </DrawerPanel>\n            <DrawerFooter variant=\"bare\">\n              <DrawerClose render={<Button variant=\"ghost\" />}>\n                إلغاء\n              </DrawerClose>\n              <Button>حفظ</Button>\n            </DrawerFooter>\n          </Form>\n        </DrawerPopup>\n      </Drawer>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "categories": [
    "drawer"
  ],
  "type": "registry:block"
}