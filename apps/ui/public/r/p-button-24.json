{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-button-24",
  "description": "أزرار أيقونة تسجيل الدخول الاجتماعي",
  "dependencies": [
    "@remixicon/react"
  ],
