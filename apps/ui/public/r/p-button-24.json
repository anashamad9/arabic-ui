  "files": [
    {
      "path": "registry/default/particles/p-button-24.tsx",
      "content": "import {\n  RiFacebookFill,\n  RiGithubFill,\n  RiGoogleFill,\n  RiTwitterXFill,\n} from \"@remixicon/react\";\nimport { Button } from \"@/registry/default/ui/button\";\n\nexport default function Particle() {\n  return (\n    <div className=\"inline-flex flex-wrap gap-2\">\n      <Button\n        aria-label=\"تسجيل الدخول باستخدام غوغل\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <RiGoogleFill aria-hidden=\"true\" />\n      </Button>\n      <Button\n        aria-label=\"تسجيل الدخول مع الفيسبوك\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <RiFacebookFill aria-hidden=\"true\" />\n      </Button>\n      <Button\n        aria-label=\"تسجيل الدخول باستخدام إكس\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <RiTwitterXFill aria-hidden=\"true\" />\n      </Button>\n      <Button\n        aria-label=\"تسجيل الدخول باستخدام غيت هب\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <RiGithubFill aria-hidden=\"true\" />\n      </Button>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "categories": [
    "button"
  ],
  "type": "registry:block"
}