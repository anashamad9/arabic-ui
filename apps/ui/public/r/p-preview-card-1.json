      "path": "registry/default/particles/p-preview-card-1.tsx",
      "content": "import { CornerUpLeftIcon, StarIcon } from \"lucide-react\";\nimport { Button } from \"@/registry/default/ui/button\";\nimport {\n  PreviewCard,\n  PreviewCardPopup,\n  PreviewCardTrigger,\n} from \"@/registry/default/ui/preview-card\";\n\nexport default function Particle() {\n  return (\n    <PreviewCard>\n      <PreviewCardTrigger render={<Button variant=\"ghost\" />}>\n        COSS UI/Arabic\n      </PreviewCardTrigger>\n      <PreviewCardPopup>\n        <div className=\"flex flex-col gap-4\">\n          <div className=\"flex flex-col gap-1\">\n            <h4 className=\"font-medium text-sm\">COSS UI/Arabic</h4>\n            <p className=\"text-muted-foreground text-sm\">\n              مكونات مصممة بشكل جميل يمكنك نسخها ولصقها في تطبيقاتك.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-4 text-muted-foreground text-xs\">\n            <div className=\"flex items-center gap-1\">\n              <span\n                aria-hidden=\"true\"\n                className=\"size-2 rounded-full bg-blue-500\"\n              />\n              <span>تايب سكريبت</span>\n            </div>\n            <div className=\"flex items-center gap-1\">\n              <StarIcon className=\"size-3\" />\n              <span>٥٨٫٢ ألف</span>\n            </div>\n            <div className=\"flex items-center gap-1\">\n              <CornerUpLeftIcon className=\"size-3\" />\n              <span>٥٫١ ألف</span>\n            </div>\n          </div>\n        </div>\n      </PreviewCardPopup>\n    </PreviewCard>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "categories": [
    "preview card"
  ],
  "type": "registry:block"
}