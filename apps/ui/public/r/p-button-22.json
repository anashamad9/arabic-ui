{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-button-22",
  "description": "أزرار التحكم في لوحة الاتجاه",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@arabicui/button"
  ],
  "files": [
    {
      "path": "registry/default/particles/p-button-22.tsx",
      "content": "import {\n  ChevronDownIcon,\n  ChevronLeftIcon,\n  ChevronRightIcon,\n  ChevronUpIcon,\n  CircleIcon,\n} from \"lucide-react\";\nimport { Button } from \"@/registry/default/ui/button\";\n\nexport default function Particle() {\n  return (\n    <div className=\"inline-grid w-fit grid-cols-3 gap-1\">\n      <Button\n        aria-label=\"عموم الكاميرا حتى\"\n        className=\"col-start-2\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <ChevronUpIcon aria-hidden=\"true\" />\n      </Button>\n      <Button\n        aria-label=\"كاميرا عموم اليسار\"\n        className=\"col-start-1\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <ChevronLeftIcon className=\"rtl:rotate-180\" aria-hidden=\"true\" />\n      </Button>\n      <div aria-hidden=\"true\" className=\"flex items-center justify-center\">\n        <CircleIcon className=\"size-4 opacity-80\" />\n      </div>\n      <Button aria-label=\"كاميرا عموم الحق\" size=\"icon\" variant=\"outline\">\n        <ChevronRightIcon className=\"rtl:rotate-180\" aria-hidden=\"true\" />\n      </Button>\n      <Button\n        aria-label=\"كاميرا عموم أسفل\"\n        className=\"col-start-2\"\n        size=\"icon\"\n        variant=\"outline\"\n      >\n        <ChevronDownIcon aria-hidden=\"true\" />\n      </Button>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "categories": [
    "button"
  ],
  "type": "registry:block"
}