{
  "name": "arabicui",
  "version": "0.0.1",
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.1"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.3.1",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=ui --filter=www",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf node_modules",
    "dev": "turbo run dev --filter=www --filter=ui",
    "format": "biome format --write .",
    "format:all": "biome check --write --unsafe --no-errors-on-unmatched",
    "lint": "turbo run lint --",
    "prepare": "husky",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "turbo run typecheck",
    "dev:local": "PORT=3001 turbo run dev --filter=www --filter=ui --ui=stream --env-mode=loose -- --hostname 127.0.0.1",
    "test:e2e": "playwright test",
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "start:local": "PORT=3001 turbo run start --filter=www --filter=ui --ui=stream --env-mode=loose -- --hostname 127.0.0.1"
  },
  "workspaces": [
    "apps/*",
    "apps/examples/*",
    "packages/*"
  ]
}
